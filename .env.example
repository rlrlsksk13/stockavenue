# stockavenue 환경변수 템플릿.
# 실제 값은 이 파일을 복사해 `.env` 로 만들어 채우세요 (`.env` 는 .gitignore 로 커밋되지 않음).
#   cp .env.example .env

# Anthropic — 무역 품목명(영문) 한글 번역
ANTHROPIC_API_KEY=

# Google Gemini — Paper Maker 문서 분석 / 뉴스 헤드라인 번역
GEMINI_API_KEY=

# US Census International Trade API — 미국 무역통계 (https://api.data.gov/signup/)
CENSUS_API_KEY=

# 관세청 수출입무역통계 — 한국 무역통계 (data.go.kr 데이터셋 15101609 활용신청)
KCS_API_KEY=
